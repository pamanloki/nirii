// Niri WM Colors Configuration (Generated by flavours)
// Place this at ~/.config/niri/colors.kdl
// Start flavours

layout {
    focus-ring {
        active-color "#a5cab8"
        inactive-color "#393939"
    }
    
    border {
        active-color "#a5cab8"
        inactive-color "#393939"
    }
    
    tab-indicator {
        active-color "#a5cab8"
        inactive-color "#393939"
        urgent-color "#f16e65"
    }
}

overview {
    backdrop-color "#131515"
}

recent-windows {
    highlight {
        active-color "#a5cab8ff"
        urgent-color "#f16e65ff"
     }
}


// End flavours